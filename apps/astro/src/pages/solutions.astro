---
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/sections/PageHero.astro'
import CTABand from '../components/sections/CTABand.astro'
import { solutions } from '../content/solutions'

const c = solutions
---

<Layout
  title={c.meta.title}
  description={c.meta.description}
>
  <!-- ═══ 01 · 页头 ═══ -->
  <PageHero
    kicker={c.hero.kicker}
    description={c.hero.description}
    stats={c.hero.stats}
  >
    {c.hero.titleA}<br />{c.hero.titleEm && <em>{c.hero.titleEm}</em>}
  </PageHero>

  <!-- ═══ 02 · 行业索引（手风琴） ═══ -->
  <section class="index-section">
    <div class="site-container">
      <div class="index-list" data-accordion data-single>
        {
          c.industries.map((ind, i) => (
            <article class={`index-band tone-${ind.tone}${i === 0 ? ' is-open' : ''}`} data-reveal="40">
              <button class="band-head" type="button" data-accordion-trigger>
                <span class="band-no tnum">0{i + 1}</span>
                <span class="band-title">
                  <span class="bt-main">{ind.label}</span>
                  <span class="bt-meta">{ind.meta}</span>
                </span>
                <span class="band-blurb">{ind.blurb}</span>
                <span class="band-chevron">
                  <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </button>

              <div class="band-detail" data-accordion-panel>
                <div class="detail-grid">
                  <div class="detail-col pain">
                    <div class="col-label">
                      <span class="col-dot"></span>
                      <h3>行业痛点</h3>
                      <span class="col-count tnum">{ind.painPoints.length}</span>
                    </div>
                    <ol class="num-list">
                      {ind.painPoints.map((point, p) => (
                        <li>
                          <span class="num tnum">{p + 1}</span>
                          <span class="text">{point}</span>
                        </li>
                      ))}
                    </ol>
                  </div>

                  <div class="detail-col solve">
                    <div class="col-label">
                      <span class="col-dot"></span>
                      <h3>解决方案</h3>
                      <span class="col-count tnum">{ind.solutions.length}</span>
                    </div>
                    <ul class="tick-list">
                      {ind.solutions.map((sol) => (
                        <li>
                          <span class="tick">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6.5l2.5 2.5 4.5-5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          </span>
                          <span class="text">{sol}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="detail-scenes">
                  <div class="scenes-title">应用场景</div>
                  <div class="scenes-grid">
                    {ind.scenarios.map((scene, s) => (
                      <div class="scene">
                        <span class="scene-no tnum">0{s + 1}</span>
                        <div class="scene-text">
                          <h4>{scene.title}</h4>
                          <p>{scene.desc}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="detail-foot">
                  <button class="cta-link" type="button" data-open-lead>
                    了解{ind.label}方案
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ 03 · 收尾转化带 ═══ -->
  <CTABand
    kicker={c.cta.kicker}
    heading={c.cta.heading}
    desc={c.cta.desc}
    btnText={c.cta.btnText}
  />

  <style>
    /* ═══ 02 · 行业索引 ═══ */
    .index-section {
      padding: 96px 0 112px;
    }
    .index-list {
      border-top: 1px solid var(--neutral-200);
    }
    .index-band {
      border-bottom: 1px solid var(--neutral-200);
      transition: background var(--transition-normal);
    }
    .band-head {
      width: 100%;
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr) minmax(0, 1.1fr) 44px;
      gap: 24px;
      align-items: center;
      padding: 30px 12px;
      background: transparent;
      border: 0;
      cursor: pointer;
      text-align: left;
      font-family: inherit;
    }
    .band-head:hover .bt-main {
      color: var(--brand-color-active);
    }
    .band-no {
      font-size: 22px;
      font-weight: 800;
      color: var(--neutral-200);
      letter-spacing: -0.02em;
      transition: color var(--transition-fast);
    }
    .band-title {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .bt-main {
      font-size: 26px;
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: -0.01em;
      transition: color var(--transition-fast);
    }
    .bt-meta {
      font-size: 12px;
      color: var(--text-tertiary);
    }
    .band-blurb {
      font-size: 14px;
      line-height: 1.6;
      color: var(--text-secondary);
      max-width: 46ch;
    }
    .band-chevron {
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      border: 1px solid var(--neutral-200);
      color: var(--text-tertiary);
      transition: all var(--transition-fast);
    }
    .band-chevron svg {
      transition: transform var(--transition-fast);
    }
    .index-band.is-open {
      background: var(--neutral-50);
    }
    .index-band.is-open .band-no {
      color: var(--brand-color-active);
    }
    .index-band.is-open .band-chevron {
      border-color: var(--brand-color);
      color: var(--brand-color-active);
    }
    .index-band.is-open .band-chevron svg {
      transform: rotate(90deg);
    }

    /* 详情区 */
    .band-detail {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 420ms cubic-bezier(0.22, 0.61, 0.36, 1), opacity 300ms ease;
    }
    .band-detail.is-open {
      max-height: 1400px;
      opacity: 1;
    }
    .detail-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 24px;
      padding: 12px 12px 0 108px;
    }
    .detail-col {
      padding: 28px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--neutral-200);
      background: #fff;
    }
    .detail-col.pain {
      background: var(--neutral-50);
    }
    .col-label {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 22px;
    }
    .col-dot {
      width: 8px;
      height: 8px;
      border-radius: 2px;
      background: var(--brand-color);
    }
    .col-label h3 {
      margin: 0;
      font-size: 16px;
      color: var(--text-primary);
    }
    .col-count {
      margin-left: auto;
      font-size: 13px;
      font-weight: 700;
      color: var(--neutral-300);
    }
    .num-list,
    .tick-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .num-list li,
    .tick-list li {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      font-size: 15px;
      line-height: 1.6;
      color: var(--text-secondary);
    }
    .num-list .num {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      border-radius: 6px;
      background: #fff;
      border: 1px solid var(--neutral-200);
      color: var(--brand-color-active);
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 2px;
    }
    .tick-list .tick {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      border-radius: 6px;
      background: var(--brand-color-bg);
      color: var(--brand-color-active);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 2px;
    }

    /* 应用场景 */
    .detail-scenes {
      margin: 24px 12px 0 108px;
      padding: 28px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--neutral-200);
      background: linear-gradient(150deg, var(--brand-color-bg), rgba(255, 255, 255, 0.9));
    }
    .scenes-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 22px;
    }
    .scenes-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .scene {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 18px;
      background: #fff;
      border: 1px solid var(--neutral-200);
      border-radius: var(--radius-md);
      transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
    }
    .scene:hover {
      transform: translateY(-3px);
      border-color: var(--brand-color);
      box-shadow: var(--shadow-md);
    }
    .scene-no {
      font-size: 12px;
      font-weight: 700;
      color: var(--neutral-300);
    }
    .scene-text h4 {
      margin: 0 0 4px;
      font-size: 15px;
      color: var(--text-primary);
    }
    .scene-text p {
      margin: 0;
      font-size: 13px;
      color: var(--text-tertiary);
    }

    .detail-foot {
      padding: 28px 12px 32px 108px;
    }
    .cta-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: 999px;
      background: var(--brand-gradient);
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      border: 0;
      cursor: pointer;
      transition: transform var(--transition-fast);
    }
    .cta-link svg {
      transition: transform var(--transition-fast);
    }
    .cta-link:hover {
      transform: translateY(-2px);
    }
    .cta-link:hover svg {
      transform: translateX(3px);
    }

    /* tone 强调：云雀走低饱和琥珀 */
    .index-band.tone-yunque .tick-list .tick {
      background: var(--color-yunque-bg);
      color: var(--color-yunque);
    }
    .index-band.tone-yunque .detail-scenes {
      background: linear-gradient(150deg, var(--color-yunque-bg), rgba(255, 255, 255, 0.9));
    }

    /* tone 强调：ERP 走低饱和蓝 */
    .index-band.tone-erp .tick-list .tick {
      background: var(--color-erp-bg);
      color: var(--color-erp);
    }
    .index-band.tone-erp .detail-scenes {
      background: linear-gradient(150deg, var(--color-erp-bg), rgba(255, 255, 255, 0.9));
    }
    .index-band.tone-erp .band-head:hover .bt-main {
      color: var(--color-erp);
    }
    .index-band.tone-erp.is-open .band-no,
    .index-band.tone-erp.is-open .band-chevron {
      color: var(--color-erp);
    }

    @media (prefers-reduced-motion: reduce) {
      .scene,
      .scene:hover {
        transition: none;
        transform: none;
      }
    }

    /* ═══ Responsive ═══ */
    @media (max-width: 1080px) {
      .band-head {
        grid-template-columns: 56px minmax(0, 1fr) 40px;
      }
      .band-blurb,
      .row-blurb {
        display: none;
      }
      .detail-grid,
      .detail-scenes {
        padding-left: 68px;
      }
      .detail-foot {
        padding-left: 68px;
      }
    }
    @media (max-width: 900px) {
      .scenes-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 768px) {
      .index-section {
        padding: 56px 0 64px;
      }
      .band-head {
        grid-template-columns: 40px minmax(0, 1fr) 36px;
        gap: 14px;
        padding: 20px 6px;
      }
      .band-head .bt-main {
        font-size: 21px;
      }
      .band-chevron {
        width: 36px;
        height: 36px;
      }
      .detail-grid {
        grid-template-columns: 1fr;
        padding: 12px 6px 0;
      }
      .detail-scenes {
        margin: 16px 6px 0;
      }
      .detail-foot {
        padding: 20px 6px 24px;
      }
    }
    @media (max-width: 560px) {
      .scenes-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>

<script>
  // 手风琴：点击展开/收起，data-single 时互斥
  const list = document.querySelector('[data-accordion]') as HTMLElement
  const single = list.hasAttribute('data-single')
  const bands = Array.from(list.querySelectorAll('.index-band')) as HTMLElement[]

  function setOpen(band: HTMLElement, open: boolean) {
    band.classList.toggle('is-open', open)
    const panel = band.querySelector('[data-accordion-panel]') as HTMLElement
    panel.classList.toggle('is-open', open)
  }

  for (const band of bands) {
    const trigger = band.querySelector('[data-accordion-trigger]') as HTMLButtonElement
    trigger.addEventListener('click', () => {
      const willOpen = !band.classList.contains('is-open')
      if (single) {
        bands.forEach((b) => setOpen(b, false))
      }
      setOpen(band, willOpen)
    })
  }
</script>