---
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/sections/PageHero.astro'
import PricingTable from '../components/sections/PricingTable.astro'
import { pricing } from '../content/pricing'

const c = pricing
---

<Layout
  title={c.meta.title}
  description={c.meta.description}
>
  <PageHero
    kicker={c.hero.kicker}
    description={c.hero.description}
  >
    {c.hero.titleA}<br /><em>{c.hero.titleEm}</em>
  </PageHero>

  <!-- ═══ 02 · 方案堆叠带 ═══ -->
  <PricingTable plans={c.plans} />

  <!-- ═══ 03 · ERP 与云雀 ═══ -->
  <section class="eco-section">
    <div class="grid-texture"></div>
    <div class="site-container">
      <div class="eco-inner" data-reveal>
        <span class="kicker kicker--white kicker--center">{c.eco.kicker}</span>
        <h2>{c.eco.heading}</h2>
        <p>
          {c.eco.desc}
        </p>
        <div class="eco-links">
          {c.eco.links.map((link) => (
            <a
              class={`eco-btn${link.ghost ? ' ghost' : ''}`}
              href={link.href}
              target="_blank"
              rel="noopener"
            >
              {link.label}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 04 · 常见问题 ═══ -->
  <section class="faq-section">
    <div class="site-container">
      <div class="faq-inner" data-reveal>
        <span class="kicker kicker--center">常见问题</span>
        <h2>几个常被问到的问题</h2>
        <div class="faq-list" data-faq>
          {c.faqs.map((f, i) => (
            <div class="faq-item">
              <button class="faq-q" type="button" data-faq-q>
                <span class="fq-text">{f.q}</span>
                <span class="fq-toggle"><span class="plus"></span></span>
              </button>
              <div class="faq-a" data-faq-a>{f.a}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ═══ 03 · ERP 与云雀 ═══ */
    .eco-section {
      position: relative;
      padding: 88px 0;
      background:
        radial-gradient(circle at 82% 20%, rgba(184, 134, 63, 0.16), transparent 40%),
        linear-gradient(150deg, #0c2a2e 0%, #164a50 60%, #1b5f65 100%);
      color: #fff;
      text-align: center;
      isolation: isolate;
      overflow: hidden;
    }
    .eco-inner {
      position: relative;
    }
    .eco-inner h2 {
      margin: 0 0 16px;
      font-size: clamp(26px, 3vw, 36px);
      font-weight: 800;
    }
    .eco-inner p {
      margin: 0 auto 40px;
      max-width: 48ch;
      font-size: 16px;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.78);
    }
    .eco-links {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .eco-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0 28px;
      height: 48px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: transparent;
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    .eco-btn svg {
      transition: transform var(--transition-fast);
    }
    .eco-btn:hover {
      background: rgba(255, 255, 255, 0.08);
    }
    .eco-btn:hover svg {
      transform: translateX(3px);
    }
    .eco-btn.ghost {
      background: #fff;
      border-color: #fff;
      color: var(--brand-color-active);
      font-weight: 700;
    }
    .eco-btn.ghost:hover {
      transform: translateY(-2px);
    }

    /* ═══ 04 · 常见问题 ═══ */
    .faq-section {
      padding: 96px 0;
    }
    .faq-inner {
      max-width: 820px;
      margin: 0 auto;
    }
    .faq-inner .kicker {
      margin-bottom: 12px;
    }
    .faq-inner h2 {
      margin: 0 0 48px;
      text-align: center;
      font-size: clamp(24px, 3vw, 32px);
      font-weight: 800;
      color: var(--text-primary);
    }
    .faq-list {
      border-top: 1px solid var(--neutral-200);
    }
    .faq-q {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 22px 4px;
      background: none;
      border: 0;
      border-bottom: 1px solid var(--neutral-200);
      cursor: pointer;
      text-align: left;
      font-family: inherit;
    }
    .fq-text {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .fq-toggle {
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      border-radius: 50%;
      border: 1px solid var(--neutral-200);
      position: relative;
      transition: all var(--transition-fast);
    }
    .fq-toggle .plus {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 12px;
      height: 12px;
    }
    .fq-toggle .plus::before,
    .fq-toggle .plus::after {
      content: '';
      position: absolute;
      background: var(--text-tertiary);
      transition: all var(--transition-fast);
    }
    .fq-toggle .plus::before {
      left: 0;
      right: 0;
      top: 50%;
      height: 1.6px;
      transform: translateY(-50%);
    }
    .fq-toggle .plus::after {
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1.6px;
      transform: translateX(-50%);
    }
    .faq-q:hover .fq-toggle {
      border-color: var(--brand-color);
    }
    .faq-q:hover .fq-toggle .plus::before,
    .faq-q:hover .fq-toggle .plus::after {
      background: var(--brand-color);
    }
    .faq-q.is-open .fq-toggle .plus::after {
      transform: translateX(-50%) scaleY(0);
    }
    .faq-a {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      padding: 0 4px;
      font-size: 15px;
      line-height: 1.8;
      color: var(--text-secondary);
      transition: max-height 320ms cubic-bezier(0.22, 0.61, 0.36, 1), opacity 240ms ease, padding var(--transition-fast);
    }
    .faq-a.is-open {
      max-height: 320px;
      opacity: 1;
      padding: 2px 4px 26px;
    }
    @media (prefers-reduced-motion: reduce) {
      .faq-a,
      .faq-a.is-open {
        max-height: none;
        opacity: 1;
        padding: 2px 4px 26px;
        transition: none;
      }
    }

    /* ═══ Responsive ═══ */
    @media (max-width: 900px) {
      .plan-band {
        grid-template-columns: 1fr;
        gap: 28px;
        padding: 32px;
      }
      .band-features {
        grid-template-columns: 1fr 1fr;
      }
    }
    @media (max-width: 768px) {
      .page-hero {
        padding: 56px 0 64px;
      }
      .pricing-section {
        padding: 64px 0 72px;
      }
      .faq-section {
        padding: 64px 0;
      }
      .plan-band {
        padding: 28px 22px;
      }
      .band-features {
        grid-template-columns: 1fr;
      }
      .eco-links {
        flex-direction: column;
        align-items: stretch;
      }
      .eco-btn {
        justify-content: center;
      }
    }
  </style>
</Layout>

<script>
  // FAQ 手风琴：点击展开，互斥
  const list = document.querySelector('[data-faq]') as HTMLElement
  const items = Array.from(list.querySelectorAll('.faq-item')) as HTMLElement[]

  function setFaq(item: HTMLElement, open: boolean) {
    const btn = item.querySelector('[data-faq-q]') as HTMLButtonElement
    const ans = item.querySelector('[data-faq-a]') as HTMLElement
    btn.classList.toggle('is-open', open)
    ans.classList.toggle('is-open', open)
  }

  for (const item of items) {
    const btn = item.querySelector('[data-faq-q]') as HTMLButtonElement
    btn.addEventListener('click', () => {
      const willOpen = !item.classList.contains('is-open')
      items.forEach((i) => setFaq(i, false))
      setFaq(item, willOpen)
    })
  }
</script>