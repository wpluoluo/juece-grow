---
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/sections/PageHero.astro'
import FeatureGrid from '../components/sections/FeatureGrid.astro'
import CTABand from '../components/sections/CTABand.astro'
import { features } from '../content/features'

const c = features

/** 智能体组成图标：按 icon 键返回 SVG 内部路径。 */
const agentIcons: Record<'task' | 'memory' | 'gov' | 'ext', string> = {
  task: '<path d="M3 4h14v12H3z" stroke="currentColor" stroke-width="1.5"/><path d="M7 8h6M7 11h6" stroke="currentColor" stroke-width="1.5"/>',
  memory: '<rect x="3" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="11" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="11" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/>',
  gov: '<path d="M7 5l6 5-6 5V5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>',
  ext: '<circle cx="10" cy="10" r="2" fill="currentColor"/><path d="M10 3l2 3h-4l2-3zM6 6l1 3-3 1 2-4zM14 6l-1 3 3 1-2-4z" stroke="currentColor" stroke-width="1.2"/>',
}
---

<Layout
  title={c.meta.title}
  description={c.meta.description}
>
  <!-- ═══ 01 · 页头 ═══ -->
  <PageHero
    kicker={c.hero.kicker}
    description={c.hero.description}
    stats={c.hero.stats}
  >
    {c.hero.titleA}<br /><em>{c.hero.titleEm}</em>
  </PageHero>

  <!-- ═══ 02 · 能力目录 ═══ -->
  <section class="cap-section">
    <div class="site-container">
      <div class="cap-list">
        {c.caps.map((cap) => {
          const p = cap.panel
          const panelJsx = (
            p.kind === 'blocks' ? (
              <div class="data-panel">
                <div class="dp-head">
                  <span class="dp-title">{p.title}</span>
                  <span class="dp-badge">{p.badge}</span>
                </div>
                <div class="dp-blocks">
                  {p.blocks.map((b) => (
                    <div class="dp-block">
                      <span class="db-no tnum">{b.no}</span>
                      <div class="db-body">
                        <span class="db-name">{b.name}</span>
                        <span class="db-note">{b.note}</span>
                      </div>
                      <div class="db-bar"><i style={`width:${b.w}`}></i></div>
                    </div>
                  ))}
                </div>
              </div>
            ) : p.kind === 'chips' ? (
              <div class="data-panel">
                <div class="dp-head">
                  <span class="dp-title">{p.title}</span>
                  <span class="dp-badge">{p.badge}</span>
                </div>
                <div class="dp-chips">
                  {p.chips.map((ch) => <span class="dp-chip">{ch}</span>)}
                </div>
                <div class="dp-rows">
                  {p.rows.map((r) => (
                    <div class="dp-row">
                      <span class="dr-label">{r.label}</span>
                      <div class="dr-track"><i style={`width:${r.w}%`}></i></div>
                      <span class="dr-val">{r.val}</span>
                    </div>
                  ))}
                </div>
              </div>
            ) : p.kind === 'bars' ? (
              <div class="data-panel">
                <div class="dp-head">
                  <span class="dp-title">{p.title}</span>
                  <span class="dp-badge">{p.badge}</span>
                </div>
                <div class="dp-kpis">
                  {p.kpis.map((k) => <div class="kpi"><span class="kpi-val tnum">{k.val}</span><span class="kpi-label">{k.label}</span></div>)}
                </div>
                <div class="dp-bars">
                  {p.bars.map((h) => <div class="bar" style={`height:${h}%`}></div>)}
                </div>
                <div class="dp-axis">
                  {p.months.map((m) => <span>{m}</span>)}
                </div>
              </div>
            ) : p.kind === 'journey' ? (
              <div class="data-panel">
                <div class="dp-head">
                  <span class="dp-title">{p.title}</span>
                  <span class="dp-badge">{p.badge}</span>
                </div>
                <ol class="dp-journey">
                  {p.steps.map((s, i) => (
                    <li><span class="step tnum">{i + 1}</span>{s}</li>
                  ))}
                </ol>
              </div>
            ) : (
              <div class="data-panel yb-panel">
                <div class="dp-head">
                  <span class="dp-title">{p.title}</span>
                  <span class="dp-badge">{p.badge}</span>
                </div>
                <div class="agent-map">
                  <div class="agent-core">{p.core}</div>
                  <div class="agent-links"></div>
                  {p.pegs.map((peg) => (
                    <div class={`agent-peg ${peg.pos}`}><span class="ag-ic"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" set:html={agentIcons[peg.icon]}></svg></span><b>{peg.text}</b></div>
                  ))}
                </div>
              </div>
            )
          )

          return (
            <article class="cap" data-reveal>
              <div class="cap-head">
                <span class="cap-no tnum">{cap.no}</span>
                <div class="cap-title-wrap">
                  <span class={`cap-tag${cap.tagTone ?? ''}`}>{cap.tag}</span>
                  <h2>{cap.title}</h2>
                </div>
              </div>
              <div class={`cap-body${cap.reverse ? ' reverse' : ''}`}>
                {cap.reverse ? (
                  <>
                    {panelJsx}
                    <aside class="cap-aside">
                      <p>{cap.aside.p}</p>
                      <ul class="tick-list">
                        {cap.aside.points.map((pt) => <li>{pt}</li>)}
                      </ul>
                    </aside>
                  </>
                ) : (
                  <>
                    <aside class="cap-aside">
                      <p>{cap.aside.p}</p>
                      <ul class="tick-list">
                        {cap.aside.points.map((pt) => <li>{pt}</li>)}
                      </ul>
                    </aside>
                    {panelJsx}
                  </>
                )}
              </div>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <!-- ═══ 03 · 基础能力 ═══ -->
  <FeatureGrid
    kicker={c.base.kicker}
    heading={c.base.heading}
    items={c.base.items}
  />

  <!-- ═══ 04 · 收尾转化带 ═══ -->
  <CTABand
    kicker={c.cta.kicker}
    heading={c.cta.heading}
    desc={c.cta.desc}
    btnText={c.cta.btnText}
  />

  <style>
    /* ═══ 02 · 能力目录 ═══ */
    .cap-section {
      padding: 96px 0 80px;
    }
    .cap {
      padding: 64px 0;
      border-bottom: 1px solid var(--neutral-200);
    }
    .cap:last-child {
      border-bottom: none;
    }
    .cap-head {
      display: flex;
      align-items: flex-start;
      gap: 24px;
      margin-bottom: 40px;
    }
    .cap-no {
      flex-shrink: 0;
      font-size: 30px;
      font-weight: 800;
      color: var(--neutral-200);
      letter-spacing: -0.03em;
      padding-top: 2px;
    }
    .cap-tag {
      display: inline-flex;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 12px;
      background: var(--brand-color-bg);
      color: var(--brand-color-active);
    }
    .cap-tag.yb {
      background: var(--color-yunque-bg);
      color: var(--color-yunque);
    }
    .cap-title-wrap h2 {
      margin: 0;
      font-size: clamp(24px, 2.6vw, 30px);
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: -0.01em;
    }
    .cap-body {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 48px;
      align-items: center;
    }
    .cap-body.reverse {
      direction: rtl;
    }
    .cap-body.reverse > * {
      direction: ltr;
    }
    .cap-aside p {
      margin: 0 0 26px;
      font-size: 15px;
      line-height: 1.8;
      color: var(--text-secondary);
    }
    .tick-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .tick-list li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 15px;
      color: var(--text-primary);
    }
    .tick-list li::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 2px;
      background: var(--brand-color);
      flex-shrink: 0;
      margin-top: 8px;
    }

    /* 深青数据面板 */
    .data-panel {
      position: relative;
      padding: 32px;
      border-radius: 22px;
      background:
        radial-gradient(circle at 85% 10%, rgba(47, 143, 150, 0.22), transparent 44%),
        linear-gradient(160deg, #0c2a2e 0%, #123c41 58%, #1a4c52 100%);
      color: #fff;
      box-shadow: 0 30px 60px rgba(9, 34, 38, 0.2);
      overflow: hidden;
      min-height: 300px;
    }
    .dp-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 28px;
    }
    .dp-title {
      font-size: 15px;
      font-weight: 700;
    }
    .dp-badge {
      font-size: 12px;
      font-weight: 600;
      color: #9fe1e5;
      background: rgba(47, 143, 150, 0.25);
      padding: 4px 12px;
      border-radius: 999px;
    }

    /* 版块组成 */
    .dp-blocks {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .dp-block {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .db-no {
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.08);
      color: #9fe1e5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
    }
    .db-body {
      width: 128px;
      flex: none;
    }
    .db-name {
      display: block;
      font-size: 14px;
      font-weight: 600;
    }
    .db-note {
      display: block;
      margin-top: 2px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.55);
    }
    .db-bar {
      flex: 1;
      height: 6px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 3px;
      overflow: hidden;
    }
    .db-bar i {
      display: block;
      height: 100%;
      border-radius: 3px;
      background: linear-gradient(90deg, var(--brand-color), #5fb3b9);
    }

    /* 营销玩法 */
    .dp-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 28px;
    }
    .dp-chip {
      font-size: 13px;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.07);
      color: #cfeef0;
      border: 1px solid rgba(127, 211, 216, 0.18);
    }
    .dp-rows {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .dp-row {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 13px;
    }
    .dr-label {
      width: 36px;
      flex: none;
      color: rgba(255, 255, 255, 0.66);
    }
    .dr-track {
      flex: 1;
      height: 6px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 3px;
      overflow: hidden;
    }
    .dr-track i {
      display: block;
      height: 100%;
      border-radius: 3px;
      background: linear-gradient(90deg, var(--brand-color), #5fb3b9);
    }
    .dr-val {
      width: 84px;
      flex: none;
      text-align: right;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.72);
    }

    /* 会员趋势 */
    .dp-kpis {
      display: flex;
      gap: 40px;
      margin-bottom: 28px;
    }
    .kpi-val {
      display: inline-block;
      font-size: 24px;
      font-weight: 800;
      color: #9fe1e5;
    }
    .kpi-label {
      margin-left: 6px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.55);
    }
    .dp-bars {
      display: flex;
      align-items: flex-end;
      gap: 12px;
      height: 120px;
      padding: 0 2px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .bar {
      flex: 1;
      border-radius: 4px 4px 0 0;
      background: linear-gradient(180deg, #6fc1c7, var(--brand-color));
      opacity: 0.9;
    }
    .dp-axis {
      display: flex;
      justify-content: space-between;
      margin-top: 8px;
      font-size: 11px;
      color: rgba(255, 255, 255, 0.45);
    }

    /* 订单旅程 */
    .dp-journey {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 24px;
    }
    .dp-journey li {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 16px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.07);
      font-size: 14px;
      font-weight: 500;
    }
    .dp-journey .step {
      width: 26px;
      height: 26px;
      flex-shrink: 0;
      border-radius: 8px;
      background: rgba(47, 143, 150, 0.3);
      color: #9fe1e5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
    }

    /* 云雀 · 智能体组成 */
    .yb-panel {
      background:
        radial-gradient(circle at 82% 12%, rgba(184, 134, 63, 0.2), transparent 44%),
        linear-gradient(160deg, #0c2a2e 0%, #123c41 60%, #1a4c52 100%);
    }
    .yb-panel .dp-badge {
      color: #e6c48c;
      background: rgba(184, 134, 63, 0.24);
    }
    .agent-map {
      position: relative;
      height: 220px;
    }
    .agent-core {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 96px;
      height: 96px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 800;
      color: #fff;
      background: linear-gradient(135deg, #b8863f, #8a6a2f);
      z-index: 2;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
    }
    .agent-links {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 200px;
      height: 200px;
      border-radius: 50%;
      border: 1px dashed rgba(230, 196, 140, 0.28);
    }
    .agent-peg {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }
    .agent-peg b {
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
    }
    .ag-ic {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(184, 134, 63, 0.2);
      color: #e6c48c;
      border: 1px solid rgba(230, 196, 140, 0.2);
    }
    .agent-peg.p1 {
      left: 50%;
      top: 0;
      transform: translateX(-50%);
    }
    .agent-peg.p2 {
      right: 0;
      top: 50%;
      transform: translateY(-50%);
    }
    .agent-peg.p3 {
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
    }
    .agent-peg.p4 {
      left: 0;
      top: 50%;
      transform: translateY(-50%);
    }

    /* ═══ Responsive ═══ */
    @media (max-width: 900px) {
      .cap-body {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .cap-body.reverse {
        direction: ltr;
      }
    }
    @media (max-width: 768px) {
      .cap-section {
        padding: 56px 0 48px;
      }
      .cap {
        padding: 44px 0;
      }
      .cap-head {
        gap: 16px;
      }
      .dp-block .db-body {
        width: 104px;
      }
    }
    @media (max-width: 560px) {
      .dp-journey {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>