---
import Layout from '../layouts/Layout.astro'
import { getArticles } from '../lib/payload'
import { siteId, type SiteId } from '../site'
import { home, type IconKey } from '../content/home'

const articles = await getArticles()
const c = home

/** 图标集：按 IconKey 返回对应 SVG 内部路径。 */
const iconPaths: Record<IconKey, string> = {
  saas: '<path d="M3 9l9-6 9 6v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 20v-7h8v7" stroke="currentColor" stroke-width="1.6"/>',
  erp: '<rect x="4" y="4" width="6" height="16" stroke="currentColor" stroke-width="1.6"/><rect x="13" y="4" width="7" height="9" stroke="currentColor" stroke-width="1.6"/>',
  yunque: '<rect x="3" y="3" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.6"/><rect x="14" y="3" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.6"/><rect x="3" y="14" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.6"/><rect x="14" y="14" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.6"/>',
}

/** 图解节点底色：tone → CSS class。 */
const nodeClass: Record<IconKey, string> = { saas: 'node-saas', erp: 'node-erp', yunque: 'node-yunque' }

/** 图解核心渐变：按站点取主色。 */
const coreGradient: Record<SiteId, [string, string]> = {
  juece: ['#3aa4ab', '#1b5f65'],
  erp: ['#5a8fb5', '#284a63'],
  yunque: ['#d3a360', '#7f5c29'],
}
const coreStops = coreGradient[siteId]

const BASE_URL: Record<SiteId, string> = {
  juece: 'https://juece.cloud',
  erp: 'https://erp.juece.cloud',
  yunque: 'https://yunque.juece.cloud',
}
const baseUrl = BASE_URL[siteId]

const homepageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${baseUrl}/#organization`,
      name: c.meta.title,
      url: baseUrl,
      logo: `${baseUrl}/og-cover.svg`,
      description: c.meta.description,
      contactPoint: { '@type': 'ContactPoint', email: '58379760@qq.com', contactType: 'sales' },
    },
    {
      '@type': 'WebSite',
      '@id': `${baseUrl}/#website`,
      url: baseUrl,
      name: c.meta.title,
      description: c.meta.description,
      publisher: { '@id': `${baseUrl}/#organization` },
      inLanguage: 'zh-CN',
    },
  ],
}

function formatDate(value?: string): string {
  if (!value) return ''
  return new Date(value).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}
---

<Layout
  title={c.meta.title}
  description={c.meta.description}
  jsonLd={homepageJsonLd}
>
  <!-- ═══ 01 · Hero ═══ -->
  <section class="hero">
    <div class="site-container hero-shell">
      <div class="hero-copy">
        <span class="kicker" data-reveal>{c.hero.kicker}</span>
        <h1 class="hero-title" data-reveal>
          {c.hero.titleLines.map((line) => (
            line.em
              ? <span class="line"><em>{line.text}</em></span>
              : <span class="line">{line.text}</span>
          ))}
        </h1>
        <p class="hero-desc" data-reveal>
          {c.hero.desc}
        </p>
        <div class="hero-actions" data-reveal>
          {c.hero.primary.action === 'lead' ? (
            <button class="btn btn--primary" type="button" data-open-lead>{c.hero.primary.label}</button>
          ) : (
            <a class="btn btn--primary" href={c.hero.primary.href}>{c.hero.primary.label}</a>
          )}
          <a class="btn btn--outline" href={c.hero.secondary.href}>{c.hero.secondary.label}</a>
        </div>

        <div class="hero-strip" data-reveal>
          {c.hero.stats.map((s) => (
            <div class="hero-stat">
              <strong>{s.strong}</strong>
              <span>{s.span}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="hero-diagram" data-reveal aria-hidden="true" data-reveal-delay="120">
        <div class="dg-panel">
          <div class="grid-texture"></div>
          <svg class="dg-svg" viewBox="0 0 480 500" fill="none">
            <g class="dg-links">
              <path d="M192 250 C 240 156, 268 148, 306 138" class="lk" />
              <path d="M192 250 L 318 250" class="lk" />
              <path d="M192 250 C 240 344, 268 352, 306 362" class="lk" />
            </g>
            <g class="dg-core">
              <circle cx="136" cy="250" r="46" fill="url(#gcore)" />
              <circle cx="136" cy="250" r="46" stroke="rgba(255,255,255,.18)" stroke-width="1.5" />
              <text x="136" y="242" text-anchor="middle" class="core-name">{c.hero.diagram.coreName}</text>
              <text x="136" y="264" text-anchor="middle" class="core-sub">{c.hero.diagram.coreSub}</text>
            </g>
            {c.hero.diagram.nodes.map((node, i) => {
              const y = 92 + i * 112
              return (
                <g class="dg-node">
                  <rect x="286" y={y} width="150" height="92" rx="18" class={`node ${nodeClass[node.tone]}`} />
                  <text x="322" y={y + 36} text-anchor="start" class="node-no">{node.no}</text>
                  <text x="322" y={y + 60} text-anchor="start" class="node-name">{node.name}</text>
                  <text x="322" y={y + 82} text-anchor="start" class="node-sub">{node.sub}</text>
                </g>
              )
            })}
            <defs>
              <linearGradient id="gcore" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color={coreStops[0]} />
                <stop offset="1" stop-color={coreStops[1]} />
              </linearGradient>
              <linearGradient id="gsaas" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2f8f96" />
                <stop offset="1" stop-color="#1b5f65" />
              </linearGradient>
            </defs>
          </svg>
          <div class="dg-chip chip-a">{c.hero.diagram.chips[0]}</div>
          <div class="dg-chip chip-b">{c.hero.diagram.chips[1]}</div>
          <div class="dg-chip chip-c">{c.hero.diagram.chips[2]}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 02 · 产品矩阵 ═══ -->
  <section class="products" id="products">
    <div class="site-container">
      <div class="sec-head split" data-reveal>
        <div>
          <span class="kicker">{c.products.kicker}</span>
          <h2 class="section-title left">{c.products.heading}</h2>
        </div>
        <p class="section-desc left">
          {c.products.desc}
        </p>
      </div>

      <div class="product-layout">
        <article class="spotlight" data-reveal>
          <div class="spotlight-top">
            <span class="spot-tag">{c.products.spotlight.tag}</span>
            <span class="spot-no tnum">01</span>
          </div>
          <div class="spot-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={iconPaths[c.products.spotlight.icon]}></svg>
          </div>
          <h3>{c.products.spotlight.name}</h3>
          <p class="spot-desc">{c.products.spotlight.desc}</p>
          <ul class="spot-list">
            {c.products.spotlight.points.map((p) => <li>{p}</li>)}
          </ul>
          <a class="text-link" href={c.products.spotlight.link.href} target={c.products.spotlight.link.external ? '_blank' : undefined} rel={c.products.spotlight.link.external ? 'noopener' : undefined}>{c.products.spotlight.link.label} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </article>

        <div class="product-side">
          {c.products.side.map((side, i) => (
            <article class={`side-card${side.icon === 'yunque' ? ' yunque' : ''}`} data-reveal>
              <div class="side-head">
                <span class="spot-tag">{side.tag}</span>
                <span class="side-no tnum">{String(i + 2).padStart(2, '0')}</span>
              </div>
              <div class="side-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={iconPaths[side.icon]}></svg>
              </div>
              <h3>{side.name}</h3>
              <p>{side.desc}</p>
              <a class="text-link" href={side.link.href} target={side.link.external ? '_blank' : undefined} rel={side.link.external ? 'noopener' : undefined}>{side.link.label} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 03 · 行业与场景 ═══ -->
  <section class="solutions">
    <div class="site-container">
      <div class="sec-head split" data-reveal>
        <div>
          <span class="kicker">{c.solutions.kicker}</span>
          <h2 class="section-title left">{c.solutions.heading.split('\n').map((line, i, arr) => (
            <>{line}{i < arr.length - 1 ? <br /> : null}</>
          ))}</h2>
        </div>
        <a class="to-all" href={c.solutions.moreHref}>{c.solutions.moreLabel} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>

      <div class="solution-rows">
        {
          c.solutions.rows.map((s, i) => (
            <a class="s-row" href="/solutions/" data-reveal>
              <span class="row-no tnum">0{i + 1}</span>
              <div class="row-body">
                <h3>{s.title} <span class="row-aud">{s.audience}</span></h3>
                <p class="row-desc">{s.desc}</p>
                <div class="row-chips">
                  {s.points.map((p) => <span>{p}</span>)}
                </div>
              </div>
              <span class="row-arrow"><svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ 04 · 真实用法 ═══ -->
  <section class="cases">
    <div class="site-container">
      <div class="sec-head split" data-reveal>
        <div>
          <span class="kicker">{c.cases.kicker}</span>
          <h2 class="section-title left">{c.cases.heading.split('\n').map((line, i, arr) => (
            <>{line}{i < arr.length - 1 ? <br /> : null}</>
          ))}</h2>
        </div>
      </div>

      <div class="case-layout">
        <article class="case-feature" data-reveal>
          <div class="cf-band">{c.cases.feature.band}</div>
          <h3>{c.cases.feature.title}</h3>
          <p class="cf-desc">{c.cases.feature.desc}</p>
          <div class="cf-foot">
            {c.cases.feature.metrics.map((m) => (
              <span class="cf-metric tnum">{m.value}<small>{m.label}</small></span>
            ))}
          </div>
        </article>

        <div class="case-stack">
          {c.cases.minis.map((mini, i) => (
            <article class="case-mini" data-reveal>
              <div class="cm-head"><span class={`cm-band${mini.tone === 'yunque' ? ' yb' : ''}`}>{mini.band}</span><span class="cm-no tnum">{['A', 'B'][i]}</span></div>
              <h3>{mini.title}</h3>
              <p>{mini.desc}</p>
              <span class={`cm-tag${mini.tone === 'yunque' ? ' yb' : ''}`}>{mini.tag}</span>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 05 · 先看看，不着急 ═══ -->
  <section class="resource">
    <div class="site-container">
      <div class="res-inner" data-reveal>
        <span class="kicker kicker--center">{c.resource.kicker}</span>
        <h2 class="section-title">{c.resource.heading}</h2>
        <p class="section-desc">{c.resource.desc}</p>
        <div class="res-links">
          {c.resource.links.map((l, i) => (
            <a class="res-link" href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined} data-reveal>
              <span class="rl-no tnum">{String(i + 1).padStart(2, '0')}</span>
              <span class="rl-main">
                <strong>{l.title}</strong>
                <small>{l.sub}</small>
              </span>
              <svg class="rl-arrow" width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 06 · CTA ═══ -->
  <section class="cta">
    <div class="site-container">
      <div class="cta-panel">
        <div class="grid-texture"></div>
        <div class="cta-head" data-reveal>
          <span class="kicker kicker--white kicker--center">{c.cta.kicker}</span>
          <h2>{c.cta.heading}</h2>
          <p>{c.cta.desc}</p>
        </div>

        <div class="cta-rows">
          {c.cta.rows.map((row) => (
            row.action === 'lead' ? (
              <button class="cta-row" type="button" data-open-lead data-reveal>
                <span class="cr-left">
                  <span class={`cr-icon ${row.icon}`}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={iconPaths[row.icon]}></svg></span>
                  <span>
                    <h3>{row.head}</h3>
                    <p>{row.desc}</p>
                  </span>
                </span>
                <span class="cr-act">{row.act} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </button>
            ) : (
              <a class="cta-row" href={row.href} target={row.external ? '_blank' : undefined} rel={row.external ? 'noopener' : undefined} data-reveal>
                <span class="cr-left">
                  <span class={`cr-icon ${row.icon}`}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={iconPaths[row.icon]}></svg></span>
                  <span>
                    <h3>{row.head}</h3>
                    <p>{row.desc}</p>
                  </span>
                </span>
                <span class="cr-act">{row.act} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </a>
            )
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 07 · 文章（嵌入式）═══ -->
  <section class="blog" id="articles">
    <div class="site-container">
      <div class="sec-head split" data-reveal>
        <div>
          <span class="kicker">{c.blog.kicker}</span>
          <h2 class="section-title left">{c.blog.heading}</h2>
        </div>
        <p class="section-desc left">{c.blog.desc}</p>
      </div>

      {
        articles.length === 0 ? (
          <p class="blog-empty">还没有发布文章，去后台写第一篇吧。</p>
        ) : (
          <ul class="blog-grid">
            {articles.map((a, i) => {
              const coverImg = a.coverImage && typeof a.coverImage === 'object' ? a.coverImage as { url: string; alt?: string } : undefined
              const coverUrl = coverImg ? new URL(coverImg.url, import.meta.env.PUBLIC_CMS_ORIGIN).href : undefined
              return (
              <li data-reveal>
                <a class="blog-card" href={`/articles/${a.slug}/`}>
                  {coverUrl && <span class="blog-card__img"><img src={coverUrl} alt={coverImg?.alt || a.title} width="800" height="600" /></span>}
                  <span class="blog-card__inner">
                    <span class="blog-card__meta">
                      {a.project && typeof a.project === 'object' && 'name' in a.project ? (a.project as { name: string }).name : ''} · {formatDate(a.publishedAt)}
                    </span>
                    <h3>{a.title}</h3>
                    {a.excerpt && <p>{a.excerpt}</p>}
                    {a.author && <span class="blog-card__author">{a.author}</span>}
                    <span class="blog-card__more">阅读全文 <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  </span>
                </a>
              </li>
              )
            })}
          </ul>
        )
      }
    </div>
  </section>

  <style>
    /* ═══ 01 · Hero ═══ */
    .hero {
      position: relative;
      padding: 72px 0 88px;
      background:
        radial-gradient(circle at 82% 12%, rgba(47, 143, 150, 0.1), transparent 34%),
        radial-gradient(circle at 10% 82%, rgba(184, 134, 63, 0.05), transparent 26%),
        linear-gradient(180deg, var(--neutral-50) 0%, #fff 100%);
    }
    .hero-shell {
      display: grid;
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
      gap: 56px;
      align-items: center;
    }
    .hero-title {
      margin: 0 0 24px;
      font-size: var(--fs-display);
      font-weight: 800;
      line-height: 1.06;
      letter-spacing: -0.03em;
      color: var(--text-primary);
    }
    .hero-title .line {
      display: block;
    }
    .hero-title em {
      font-style: normal;
      position: relative;
      color: var(--text-primary);
    }
    .hero-title em::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.06em;
      height: 0.14em;
      background: linear-gradient(90deg, rgba(47, 143, 150, 0.34), rgba(47, 143, 150, 0));
      z-index: -1;
      border-radius: 2px;
    }
    .hero-desc {
      max-width: 56ch;
      margin: 0 0 34px;
      font-size: 18px;
      line-height: 1.8;
      color: var(--text-secondary);
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 40px;
    }
    .hero-strip {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--neutral-200);
      padding-top: 18px;
    }
    .hero-stat {
      padding: 0 18px 0 0;
    }
    .hero-stat + .hero-stat {
      padding-left: 18px;
      border-left: 1px solid var(--neutral-100);
    }
    .hero-stat strong {
      display: block;
      font-size: 26px;
      font-weight: 800;
      line-height: 1;
      color: var(--brand-color-active);
      margin-bottom: 8px;
    }
    .hero-stat span {
      display: block;
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.4;
    }

    /* Hero 图解 */
    .hero-diagram {
      display: flex;
      align-items: center;
    }
    .dg-panel {
      position: relative;
      width: 100%;
      max-width: 500px;
      margin: 0 auto;
      border-radius: 24px;
      padding: 24px;
      background: linear-gradient(160deg, #123c41 0%, #1a4c52 48%, #0c2a2e 100%);
      box-shadow: 0 40px 90px rgba(9, 34, 38, 0.28);
      overflow: hidden;
      isolation: isolate;
    }
    .dg-panel::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
      border-radius: 28px;
    }
    .dg-svg {
      display: block;
      width: 100%;
      height: auto;
    }
    .dg-links .lk {
      stroke: rgba(184, 210, 214, 0.32);
      stroke-width: 1.4;
      stroke-dasharray: 5 7;
      fill: none;
      animation: dashflow 2.4s linear infinite;
    }
    .dg-core .core-name {
      fill: #fff;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 2px;
    }
    .dg-core .core-sub {
      fill: rgba(255, 255, 255, 0.82);
      font-size: 13px;
    }
    .dg-node .node-saas {
      fill: url(#gsaas);
    }
    .dg-node .node-erp {
      fill: rgba(47, 143, 150, 0.9);
    }
    .dg-node .node-yunque {
      fill: rgba(184, 134, 63, 0.92);
    }
    .dg-node .node-no {
      fill: rgba(255, 255, 255, 0.55);
      font-size: 11px;
      letter-spacing: 1px;
    }
    .dg-node .node-name {
      fill: #fff;
      font-size: 17px;
      font-weight: 700;
    }
    .dg-node .node-sub {
      fill: rgba(255, 255, 255, 0.72);
      font-size: 12px;
    }
    .dg-chip {
      position: absolute;
      padding: 9px 15px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      color: var(--neutral-700, #313c3f);
      background: #fff;
      box-shadow: var(--shadow-md);
      animation: floaty 5s ease-in-out infinite;
    }
    .dg-chip.chip-a {
      left: 12px;
      top: 26px;
    }
    .dg-chip.chip-b {
      right: 16px;
      top: 44%;
      animation-delay: -1.6s;
    }
    .dg-chip.chip-c {
      left: 20px;
      bottom: 26px;
      animation-delay: -3s;
    }
    @keyframes dashflow {
      to {
        stroke-dashoffset: -48;
      }
    }
    @keyframes floaty {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-7px);
      }
    }

    /* ═══ 02 · 产品矩阵 ═══ */
    .products,
    .solutions,
    .cases,
    .resource {
      padding: 96px 0;
    }
    .products {
      background: #fff;
    }
    .sec-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
      margin-bottom: 56px;
    }
    .sec-head .section-title {
      margin-bottom: 0;
    }
    .to-all {
      display: inline-flex;
