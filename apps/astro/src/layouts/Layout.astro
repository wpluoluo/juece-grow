---
import { site, siteId } from '../site'
import { siteProjectSlug } from '../lib/payload'
import '../styles/layout.css'

// 留资归属用当前站点的项目 slug，不暴露数值 id。
const projectSlug = siteProjectSlug[siteId]

interface Props {
  title: string
  description?: string
  /** 原始 URL，用于 canonical 与 OpenGraph。 */
  url?: string
  /** 封面图绝对地址。 */
  image?: string
  /** 页面类型：website / article。 */
  type?: 'website' | 'article'
  /** SEO 标题缺省用页面标题。 */
  seoTitle?: string
  /** 结构化数据 JSON-LD。 */
  jsonLd?: Record<string, unknown>
  /** 文章发布时间（仅 type=article 用）。 */
  articlePublishedTime?: string
  /** 文章修改时间（仅 type=article 用）。 */
  articleModifiedTime?: string
  /** 文章标签（仅 type=article 用）。 */
  articleTag?: string
}

const {
  title,
  description = '',
  url,
  image,
  type = 'website',
  seoTitle,
  jsonLd,
  articlePublishedTime,
  articleModifiedTime,
  articleTag,
} = Astro.props

const canonical = url || Astro.url.href
const ogTitle = seoTitle || title
const ogImage = image || new URL('/og-cover.svg', Astro.site || Astro.url).href

const path = Astro.url.pathname
function current(href: string): string | undefined {
  const cleaned = href === '/' ? '/' : href.replace(/\/+$/, '')
  const page = path === '/' ? '/' : path.replace(/\/+$/, '')
  return page === cleaned ? 'page' : undefined
}

const year = new Date().getFullYear()

// Chatwoot 在线客服：配置了 URL 与网站 token 才注入控件，缺任一项则关闭。
const chatwootUrl = import.meta.env.PUBLIC_CHATWOOT_URL as string | undefined
const chatwootToken = import.meta.env.PUBLIC_CHATWOOT_WEBSITE_TOKEN as string | undefined
const enableChat = Boolean(chatwootUrl && chatwootToken)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232f8f96'/%3E%3Cpath d='M10 22V12L16 8L22 12V22L16 26L10 22Z' stroke='white' stroke-width='1.8' fill='none'/%3E%3Ccircle cx='16' cy='17' r='3' fill='white' opacity='0.85'/%3E%3C/svg%3E"
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={ogImage} />}
    <meta property="og:site_name" content={site.brand.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {image && <meta name="twitter:image" content={ogImage} />}

    {type === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {type === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {type === 'article' && articleTag && <meta property="article:tag" content={articleTag} />}

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

    <style is:global define:vars={{
      'brand-color': site.brand.colors.themeColor,
      'brand-color-hover': site.brand.colors.themeHover,
      'brand-color-active': site.brand.colors.themeActive,
      'brand-color-bg': site.brand.colors.themeBg,
    }}>
      /* Site 配置驱动的品牌色面：define:vars 注入为 CSS 变量，覆盖上方静态品牌变量。 */
      :root {
        --brand-gradient: linear-gradient(135deg, var(--brand-color) 0%, var(--brand-color-active) 100%);
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-container site-header__inner">
        <a class="brand" href="/">
          <svg width="34" height="34" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="url(#brand-grad)" />
            <path d="M10 22V12L16 8L22 12V22L16 26L10 22Z" stroke="white" stroke-width="1.8" fill="none" />
            <circle cx="16" cy="17" r="3" fill="white" opacity="0.85" />
            <defs>
              <linearGradient id="brand-grad" x1="0" y1="0" x2="32" y2="32">
                <stop offset="0%" stop-color={site.brand.colors.themeColor} />
                <stop offset="100%" stop-color={site.brand.colors.themeActive} />
              </linearGradient>
            </defs>
          </svg>
          <span class="brand-text">
            <span class="brand-title">{site.brand.name}</span>
            <span class="brand-subtitle">{site.brand.subtitle}</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="主导航">
          {site.nav.map((item) => (
            <a
              href={item.href}
              aria-current={
                item.href === '/#articles'
                  ? path.startsWith('/articles')
                    ? 'page'
                    : undefined
                  : current(item.href)
              }
            >{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <button class="hdr-search" type="button" data-open-search aria-label="站内搜索">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
          <a class="hdr-login" href={site.loginUrl} target="_blank" rel="noopener">登录</a>
          <button class="btn btn--primary hdr-trial" type="button" data-open-lead>{site.trialText}</button>
          <button class="hdr-burger" type="button" data-toggle-menu aria-label="打开菜单" aria-expanded="false">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <nav class="mobile-menu" id="mobile-menu" aria-label="移动端菜单">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <div class="mobile-menu__actions">
        <button class="btn btn--outline" type="button" data-open-lead>{site.trialText}</button>
        <a class="btn btn--outline" href={site.loginUrl} target="_blank" rel="noopener">登录</a>
      </div>
    </nav>

    <main data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-container">
        <div class="footer-top">
          <div class="footer-col brand-col">
            <div class="footer-logo">
              <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <rect width="32" height="32" rx="8" fill={site.brand.colors.themeColor} />
                <path d="M10 22V12L16 8L22 12V22L16 26L10 22Z" stroke="white" stroke-width="1.8" fill="none" />
                <circle cx="16" cy="17" r="3" fill="white" opacity="0.85" />
              </svg>
              <span>{site.brand.name}</span>
            </div>
            <p class="footer-desc">
              {site.footer.desc}
            </p>
          </div>

          <div class="footer-col">
            <h3>产品矩阵</h3>
            {site.footer.products.map((item) => (
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >{item.label}</a>
            ))}
          </div>

          <div class="footer-col">
            <h3>行业方案</h3>
            {site.footer.industries.map((item) => (
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >{item.label}</a>
            ))}
          </div>

          <div class="footer-col contact-col">
            <h3>联系我们</h3>
            <div class="contact-item">
              <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M2 3h16v14H2z" stroke="currentColor" stroke-width="1.4" />
                <path d="M3 5l7 6 7-6" stroke="currentColor" stroke-width="1.4" />
              </svg>
              <span>{site.contact.email}</span>
            </div>
            <div class="contact-item">
              <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.4" />
                <path d="M10 6v4l3 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
              <span>{site.contact.hours}</span>
            </div>
          </div>
        </div>

        <hr class="footer-divider" />

        <div class="footer-bottom">
          <div class="copyright">
            © {year} {site.brand.name}. All Rights Reserved.
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">{site.footer.beian}</a>
          </div>
          <div class="links">
            <a href="/privacy/">隐私政策</a>
            <a href="/terms/">服务条款</a>
            <a href="/sitemap/">站点地图</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- 留资弹窗 -->
    <div class="lead-overlay" id="lead-overlay" role="dialog" aria-modal="true" aria-labelledby="lead-title">
      <div class="lead-modal">
        <button class="lead-modal__close" type="button" data-close-lead aria-label="关闭">×</button>
        <h2 id="lead-title">先聊聊你的业务</h2>
        <p class="lead-modal__desc">
          告诉我们你做什么生意、卡在哪一环，我们给你一套顺口的推荐，直接照着谈。
        </p>
        <form id="lead-form" class="lead-form" data-project-slug={projectSlug} novalidate>
          <div class="field">
            <label for="lead-name">称呼</label>
            <input id="lead-name" name="name" type="text" autocomplete="name" placeholder="怎么称呼你" />
          </div>
          <div class="field">
            <label for="lead-phone">手机号</label>
            <input id="lead-phone" name="phone" type="tel" autocomplete="tel" inputmode="numeric" placeholder="用于联系你" />
          </div>
          <div class="field">
            <label for="lead-wechat">微信号</label>
            <input id="lead-wechat" name="wechat" type="text" autocomplete="off" placeholder="6~20 位字母数字" />
          </div>
          <div class="field">
            <label for="lead-note">想了解什么？</label>
            <textarea id="lead-note" name="note" rows="3" placeholder="产品类型、当前获客方式、想解决的问题（选填）"></textarea>
          </div>
          <p class="field__hint">手机号或微信号至少要填一个。</p>
          <button class="btn btn--primary lead-form__submit" type="submit">提交</button>
          <p id="lead-status" class="form-status" role="status" data-state="idle"></p>
        </form>
      </div>
    </div>

    <!-- 站内搜索：构建期由 Pagefind 生成静态索引，浏览器端检索 -->
    <div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-labelledby="search-title">
      <div class="search-modal">
        <div class="search-modal__bar">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input id="search-title" class="search-input" type="search" placeholder="搜索文章、功能、方案…" autocomplete="off" aria-label="站内搜索" />
          <button class="search-modal__close" type="button" data-close-search aria-label="关闭">×</button>
        </div>
        <div class="search-status" id="search-status" role="status"></div>
        <ul class="search-results" id="search-results"></ul>
        <p class="search-hint">按 Esc 关闭 · 回车打开结果</p>
      </div>
    </div>

    {enableChat && (
      <>
        <script is:inline src={`${chatwootUrl}/packs/js/sdk.js`} />
        <script is:inline define:vars={{ chatwootUrl, chatwootToken }}>
          window.chatwootSDK.run({ websiteToken: chatwootToken, baseUrl: chatwootUrl })
        </script>
      </>
    )}
  </body>
</html>

<script>
  import { CMS_ORIGIN } from '../lib/payload'

  const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  /* ── 滚动入场 ── */
  if (typeof IntersectionObserver !== 'undefined') {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in')
            io.unobserve(e.target)
          }
        }
      },
      { threshold: 0.12 }
    )
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el))
  } else {
    document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('in'))
  }
  if (REDUCE) {
    document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('in'))
  }

  /* ── 移动端菜单 ── */
  const menu = document.getElementById('mobile-menu') as HTMLElement
  const burger = document.querySelector('[data-toggle-menu]') as HTMLButtonElement | null
  function setMenu(open: boolean) {
    menu.classList.toggle('is-open', open)
    burger?.setAttribute('aria-expanded', String(open))
  }
  burger?.addEventListener('click', () => {
    setMenu(!menu.classList.contains('is-open'))
  })
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)))

  /* ── 留资弹窗 ── */
  const overlay = document.getElementById('lead-overlay') as HTMLElement
  const form = document.getElementById('lead-form') as HTMLFormElement
  const status = document.getElementById('lead-status') as HTMLElement
  const PHONE_RE = /^1[3-9]\d{9}$/
  const WECHAT_RE = /^[A-Za-z0-9_-]{6,20}$/

  function openLead() {
    overlay.classList.add('is-open')
    document.body.style.overflow = 'hidden'
  }
  function closeLead() {
    overlay.classList.remove('is-open')
    document.body.style.overflow = ''
  }
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement
    if (t.closest('[data-open-lead]')) openLead()
    if (t.closest('[data-close-lead]') || t === overlay) closeLead()
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeLead()
  })

  function setStatus(text: string, state: 'idle' | 'success' | 'error') {
    status.textContent = text
    status.dataset.state = state
  }
  function markInvalid(el: HTMLInputElement | HTMLTextAreaElement, invalid: boolean) {
    el.setAttribute('aria-invalid', String(invalid))
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    const projectSlug = form.dataset.projectSlug as string
    const nameEl = form.elements.namedItem('name') as HTMLInputElement
    const phoneEl = form.elements.namedItem('phone') as HTMLInputElement
    const wechatEl = form.elements.namedItem('wechat') as HTMLInputElement
    const noteEl = form.elements.namedItem('note') as HTMLTextAreaElement

    const phone = phoneEl.value.trim()
    const wechat = wechatEl.value.trim()
    markInvalid(phoneEl, false)
    markInvalid(wechatEl, false)

    if (!phone && !wechat) {
      markInvalid(phoneEl, true)
      markInvalid(wechatEl, true)
      setStatus('手机号或微信号至少要填一个', 'error')
      return
    }
    if (phone && !PHONE_RE.test(phone)) {
      markInvalid(phoneEl, true)
      setStatus('手机号格式不正确', 'error')
      return
    }
    if (wechat && !WECHAT_RE.test(wechat)) {
      markInvalid(wechatEl, true)
      setStatus('微信号格式不正确（6~20 位字母数字）', 'error')
      return
    }

    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement
    button.disabled = true
    setStatus('提交中…', 'idle')

    try {
      const res = await fetch(`${CMS_ORIGIN}/api/v2/leads`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          projectSlug,
          name: nameEl.value.trim(),
          phone,
          wechat,
          note: noteEl.value.trim(),
        }),
      })
      const body = await res.json()
      if (body.success) {
        setStatus('已收到，我们会尽快联系您。', 'success')
        form.reset()
      } else {
        setStatus(body.error?.message || '提交失败，请稍后再试。', 'error')
      }
    } catch {
      setStatus('提交失败，请检查网络稍后再试。', 'error')
    } finally {
      button.disabled = false
    }
  })

  /* ── 站内搜索（Pagefind 构建期索引，浏览器端检索） ── */
  const searchOverlay = document.getElementById('search-overlay') as HTMLElement
  const searchInput = document.getElementById('search-title') as HTMLInputElement
  const searchStatus = document.getElementById('search-status') as HTMLElement
  const searchResults = document.getElementById('search-results') as HTMLElement
  let pagefindApi: null | { init?: () => Promise<void>; search: (q: string) => Promise<{ results: SearchResult[] } | null> } = null
  let searchTimer = 0

  type SearchResult = {
    data: () => Promise<{ url?: string; title?: string; meta?: { title?: string } }>
    excerpt(): Promise<string>
  }

  function openSearch() {
    searchOverlay.classList.add('is-open')
    document.body.style.overflow = 'hidden'
    searchInput.focus()
  }
  function closeSearch() {
    searchOverlay.classList.remove('is-open')
    document.body.style.overflow = ''
  }
  async function loadPagefind() {
    if (pagefindApi) return
    try {
      // 变量形式让 Rollup 在构建期不做静态解析，运行期从站点根加载 Pagefind 索引
      const pagefindPath = '/pagefind/pagefind.js'
      pagefindApi = await import(/* @vite-ignore */ pagefindPath)
      await pagefindApi.init?.()
    } catch {
      pagefindApi = null
    }
  }
  async function runSearch(query: string) {
    const input = query.trim()
    searchResults.innerHTML = ''
    if (!input) {
      searchStatus.textContent = ''
      return
    }
    await loadPagefind()
    if (!pagefindApi) {
      searchStatus.classList.add('search-status--err')
      searchStatus.textContent = '搜索索引未就绪，请刷新后重试。'
      return
    }
    searchStatus.classList.remove('search-status--err')
    searchStatus.textContent = '搜索中…'
    let search
    try {
      search = await pagefindApi.search(input)
    } catch {
      searchStatus.textContent = '搜索出错，请稍后再试。'
      return
    }
    if (!search || !search.results || search.results.length === 0) {
      searchStatus.textContent = `没有找到与「${input}」相关的内容。`
      return
    }
    searchStatus.textContent = `找到 ${search.results.length} 条结果`
    const results = search.results.slice(0, 8)
    const details = await Promise.all(results.map((r) => r.data()))
    const excerpts = await Promise.all(
      results.map((r) => r.excerpt().catch(() => ''))
    )
    for (let i = 0; i < details.length; i++) {
      const detail = details[i]
      let excerpt = ''
      const excerptHtml = excerpts[i]
      if (excerptHtml) {
        const wrap = document.createElement('div')
        wrap.innerHTML = excerptHtml
        excerpt = wrap.textContent || ''
      }
      const href = detail.url || '#'
      const title = detail.meta?.title || detail.title || href
      const link = document.createElement('a')
      link.href = href
      link.innerHTML = `<span class="search-result__title"></span>${excerpt ? '<p class="search-result__excerpt"></p>' : ''}`
      ;(link.querySelector('.search-result__title') as HTMLElement).textContent = title
      if (excerpt) (link.querySelector('.search-result__excerpt') as HTMLElement).textContent = excerpt
      const li = document.createElement('li')
      li.className = 'search-result'
      li.appendChild(link)
      searchResults.appendChild(li)
    }
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimer)
    searchTimer = window.setTimeout(() => runSearch(searchInput.value), 200)
  })
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') e.preventDefault()
  })
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement
    if (t.closest('[data-open-search]')) openSearch()
    if (t.closest('[data-close-search]') || t === searchOverlay) closeSearch()
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && searchOverlay.classList.contains('is-open')) closeSearch()
  })
</script>
