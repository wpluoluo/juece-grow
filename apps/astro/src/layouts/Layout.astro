---
interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description || ''} />
    <link rel="canonical" href={Astro.url} />
    <style>
      :root {
        color-scheme: light;
        --ink: #1f2430;
        --muted: #667085;
        --line: #e6e8ec;
        --bg: #ffffff;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.7;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      header,
      footer {
        max-width: 840px;
        margin: 0 auto;
        padding: 24px 20px;
      }
      header {
        display: flex;
        gap: 20px;
        align-items: baseline;
        border-bottom: 1px solid var(--line);
      }
      header .brand {
        font-weight: 700;
      }
      header nav {
        display: flex;
        gap: 16px;
        color: var(--muted);
        font-size: 14px;
      }
      main {
        max-width: 840px;
        margin: 0 auto;
        padding: 40px 20px 64px;
      }
      footer {
        color: var(--muted);
        font-size: 13px;
        border-top: 1px solid var(--line);
      }
    </style>
  </head>
  <body>
    <header>
      <span class="brand">觉策增长</span>
      <nav>
        <a href="/">首页</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>© {new Date().getFullYear()} juece-grow · 觉策增长</footer>
  </body>
</html>