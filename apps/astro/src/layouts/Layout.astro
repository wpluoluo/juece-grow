      <>
        <script is:inline src={`${chatwootUrl}/packs/js/sdk.js`} />
        <script is:inline define:vars={{ chatwootUrl, chatwootToken }}>
          window.chatwootSDK.run({ websiteToken: chatwootToken, baseUrl: chatwootUrl })
        </script>
      </>
    )}
