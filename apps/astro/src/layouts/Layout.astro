---
interface Props {
  title: string
  description?: string
  /** 原始 URL，用于 canonical 与 OpenGraph。 */
  url?: string
  /** 封面图绝对地址。 */
  image?: string
  /** 页面类型：website / article。 */
  type?: 'website' | 'article'
  /** SEO 标题缺省用页面标题。 */
  seoTitle?: string
  /** 结构化数据 JSON-LD。 */
  jsonLd?: Record<string, unknown>
  /** 文章发布时间（仅 type=article 用）。 */
  articlePublishedTime?: string
  /** 文章修改时间（仅 type=article 用）。 */
  articleModifiedTime?: string
  /** 文章标签（仅 type=article 用）。 */
  articleTag?: string
}

const {
  title,
  description = '',
  url,
  image,
  type = 'website',
  seoTitle,
  jsonLd,
  articlePublishedTime,
  articleModifiedTime,
  articleTag,
} = Astro.props

const canonical = url || Astro.url.href
const ogTitle = seoTitle || title
const ogImage = image || new URL('/og-cover.svg', Astro.site || Astro.url).href

const path = Astro.url.pathname
function current(href: string): string | undefined {
  const cleaned = href === '/' ? '/' : href.replace(/\/+$/, '')
  const page = path === '/' ? '/' : path.replace(/\/+$/, '')
  return page === cleaned ? 'page' : undefined
}

const year = new Date().getFullYear()

// Chatwoot 在线客服：配置了 URL 与网站 token 才注入控件，缺任一项则关闭。
const chatwootUrl = import.meta.env.PUBLIC_CHATWOOT_URL as string | undefined
const chatwootToken = import.meta.env.PUBLIC_CHATWOOT_WEBSITE_TOKEN as string | undefined
const enableChat = Boolean(chatwootUrl && chatwootToken)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232f8f96'/%3E%3Cpath d='M10 22V12L16 8L22 12V22L16 26L10 22Z' stroke='white' stroke-width='1.8' fill='none'/%3E%3Ccircle cx='16' cy='17' r='3' fill='white' opacity='0.85'/%3E%3C/svg%3E"
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={ogImage} />}
    <meta property="og:site_name" content="觉策科技" />
    <meta name="twitter:card" content="summary_large_image" />
    {image && <meta name="twitter:image" content={ogImage} />}

    {type === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {type === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {type === 'article' && articleTag && <meta property="article:tag" content={articleTag} />}

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <style is:global>
      :root {
        /* Layout */
        --site-max-width: 1280px;
        --site-page-padding: 24px;

        /* Brand · 觉策青 */
        --brand-color: #2f8f96;
        --brand-color-hover: #257a80;
        --brand-color-active: #1b5f65;
        --brand-color-bg: rgba(47, 143, 150, 0.09);
        --brand-gradient: linear-gradient(135deg, #2f8f96 0%, #1b5f65 100%);
        --brand-gradient-light: linear-gradient(135deg, #e6f2f3 0%, #d4eaec 100%);

        /* Sub-brand · 云雀（低饱和琥珀） */
        --color-yunque: #b8863f;
        --color-yunque-light: #ead8ba;
        --color-yunque-bg: rgba(184, 134, 63, 0.1);

        /* Text（冷近黑） */
        --text-primary: #1a2326;
        --text-secondary: #59686c;
        --text-tertiary: #879396;

        /* Neutral（冷石墨） */
        --neutral-50: #f7f9f9;
        --neutral-100: #eef2f2;
        --neutral-200: #e0e7e7;
        --neutral-300: #c4cccc;
        --neutral-400: #99a6a8;

        /* Spacing */
        --space-sm: 8px;
        --space-md: 16px;
        --space-lg: 24px;
        --space-xl: 32px;
        --space-2xl: 48px;
        --space-3xl: 64px;

        /* Type Scale */
        --fs-display: clamp(30px, 3.6vw, 44px);
        --fs-h1: clamp(34px, 4.4vw, 52px);
        --fs-h2: clamp(26px, 3vw, 36px);
        --fs-h3: 20px;
        --fs-body: 16px;
        --fs-small: 14px;

        /* Reveal */
        --rv-dur: 640ms;
        --rv-ease: cubic-bezier(0.22, 0.61, 0.36, 1);

        /* Radius（克制统一） */
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 20px;

        /* Shadows（向青灰底色染色） */
        --shadow-sm: 0 1px 3px rgba(18, 34, 40, 0.06);
        --shadow-md: 0 4px 12px rgba(18, 34, 40, 0.08);
        --shadow-lg: 0 12px 40px rgba(18, 34, 40, 0.12);
        --shadow-xl: 0 20px 60px rgba(18, 34, 40, 0.14);

        /* Transitions */
        --transition-fast: 200ms ease;
        --transition-normal: 350ms ease;
        --transition-slow: 600ms ease;
      }

      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        color: var(--text-primary);
        background: #fff;
        font-family: 'PingFang SC', 'Microsoft YaHei', 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
          sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        font-size: var(--fs-body);
        line-height: 1.6;
        text-rendering: optimizeLegibility;
      }
      img {
        max-width: 100%;
        height: auto;
      }
      a {
        text-decoration: none;
        color: inherit;
      }
      button {
        font-family: inherit;
      }
      .tnum {
        font-variant-numeric: tabular-nums;
        font-feature-settings: 'tnum';
      }

      .site-container {
        max-width: var(--site-max-width);
        margin: 0 auto;
        padding: 0 var(--site-page-padding);
      }

      .text-gradient {
        background: var(--brand-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* Kicker：带短线的眉标 */
      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 20px;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--brand-color-active);
      }
      .kicker::before {
        content: '';
        width: 22px;
        height: 2px;
        background: var(--brand-color);
        border-radius: 2px;
      }
      .kicker--white {
        color: rgba(255, 255, 255, 0.72);
      }
      .kicker--white::before {
        background: var(--neutral-300);
      }
      .kicker--center {
        justify-content: center;
      }
      .kicker--center::after {
        content: '';
        width: 22px;
        height: 2px;
        background: var(--brand-color);
        border-radius: 2px;
      }

      /* 分节标题 */
      .section-title {
        font-size: var(--fs-h1);
        font-weight: 800;
        text-align: center;
        margin-bottom: 16px;
        line-height: 1.24;
        letter-spacing: -0.02em;
        color: var(--text-primary);
      }
      .section-title.left {
        text-align: left;
      }
      .section-title em {
        font-style: normal;
        color: var(--brand-color-active);
      }
      .section-desc {
        font-size: clamp(15px, 1.4vw, 18px);
        color: var(--text-secondary);
        text-align: center;
        max-width: 640px;
        margin: 0 auto 56px;
        line-height: 1.7;
      }
      .section-desc.left {
        text-align: left;
        margin: 0 0 24px;
        max-width: 52ch;
      }

      /* 精网格质感 */
      .grid-texture {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
          radial-gradient(circle at 50% 0%, rgba(47, 143, 150, 0.18), transparent 55%);
        background-size: 46px 46px, 46px 46px, 100% 100%;
        opacity: 0.8;
      }

      /* 滚动入场 */
      [data-reveal] {
        opacity: 0;
        transform: translateY(26px);
        transition:
          opacity var(--rv-dur) var(--rv-ease),
          transform var(--rv-dur) var(--rv-ease);
        transition-delay: var(--rv-delay, 0ms);
        will-change: opacity, transform;
      }
      [data-reveal].in {
        opacity: 1;
        transform: translateY(0);
      }

      /* 通用按钮 */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 188px;
        height: 48px;
        padding: 0 26px;
        border-radius: 999px;
        border: 1px solid transparent;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: transform var(--transition-fast), box-shadow var(--transition-fast),
          border-color var(--transition-fast), background var(--transition-fast);
      }
      .btn:hover {
        transform: translateY(-2px);
      }
      .btn--primary {
        background: var(--brand-gradient);
        color: #fff;
        box-shadow: var(--shadow-md);
      }
      .btn--primary:hover {
        box-shadow: var(--shadow-lg);
      }
      .btn--outline {
        background: #fff;
        color: var(--text-primary);
        border-color: var(--neutral-200);
      }
      .btn--outline:hover {
        border-color: var(--brand-color);
        color: var(--brand-color-active);
      }
      .btn--white {
        background: #fff;
        color: var(--brand-color-active);
      }
      .btn svg {
        transition: transform var(--transition-fast);
      }
      .btn:hover svg {
        transform: translateX(3px);
      }

      /* 滚动条与选中一致化 */
      ::selection {
        background: rgba(47, 143, 150, 0.2);
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
        [data-reveal] {
          opacity: 1;
          transform: none;
        }
      }

      /* ═══ 页头 ═══ */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--neutral-100);
      }
      .site-header__inner {
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        user-select: none;
        flex-shrink: 0;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .brand-title {
        font-size: 18px;
        font-weight: 700;
        line-height: 1.2;
        color: var(--text-primary);
      }
      .brand-subtitle {
        font-size: 11px;
        color: var(--text-secondary);
        line-height: 1.2;
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .site-nav a {
        padding: 8px 14px;
        border-radius: var(--radius-md);
        font-size: 15px;
        color: var(--text-secondary);
        transition: color var(--transition-fast), background var(--transition-fast);
      }
      .site-nav a:hover {
        color: var(--text-primary);
      }
      .site-nav a[aria-current='page'] {
        color: var(--brand-color-active);
        font-weight: 600;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }
      .hdr-login {
        font-size: 14px;
        color: var(--text-secondary);
        padding: 8px 6px;
      }
      .hdr-login:hover {
        color: var(--text-primary);
      }
      .hdr-trial {
        min-width: 0;
        height: 40px;
        padding: 0 20px;
        font-size: 14px;
      }
      .hdr-burger {
        display: none;
        width: 42px;
        height: 42px;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--neutral-200);
        border-radius: var(--radius-md);
        background: #fff;
        color: var(--text-primary);
        cursor: pointer;
      }
      .mobile-menu {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99;
        background: var(--neutral-50);
        padding: 24px;
        flex-direction: column;
        gap: 8px;
      }
      .mobile-menu.is-open {
        display: flex;
      }
      .mobile-menu a {
        padding: 15px 16px;
        border-radius: var(--radius-md);
        font-size: 16px;
        color: var(--text-primary);
        background: #fff;
        border: 1px solid var(--neutral-200);
      }
      .mobile-menu__actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 16px;
      }

      /* ═══ 页脚 ═══ */
      .site-footer {
        background: var(--neutral-50);
        padding: 60px 0 24px;
        color: var(--text-secondary);
        border-top: 1px solid var(--neutral-200);
      }
      .footer-top {
        display: flex;
        flex-wrap: wrap;
        gap: 40px;
        justify-content: space-between;
        margin-bottom: 40px;
      }
      .footer-col {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 160px;
      }
      .footer-col h3 {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 6px;
      }
      .footer-col a {
        font-size: 14px;
        color: var(--text-secondary);
        transition: color var(--transition-fast);
      }
      .footer-col a:hover {
        color: var(--brand-color);
      }
      .brand-col {
        max-width: 320px;
      }
      .footer-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 18px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 8px;
      }
      .footer-desc {
        margin: 0;
        font-size: 14px;
        line-height: 1.7;
        color: var(--text-tertiary);
      }
      .contact-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
      }
      .footer-divider {
        border: none;
        border-top: 1px solid var(--neutral-200);
        margin: 0 0 24px;
      }
      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        font-size: 13px;
        flex-wrap: wrap;
      }
      .footer-bottom .copyright {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .footer-bottom a {
        color: var(--text-tertiary);
        transition: color var(--transition-fast);
      }
      .footer-bottom a:hover {
        color: var(--brand-color);
      }
      .footer-bottom .links {
        display: flex;
        gap: 24px;
      }

      /* ═══ 留资弹窗 ═══ */
      .lead-overlay {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(12, 20, 22, 0.5);
        backdrop-filter: blur(3px);
      }
      .lead-overlay.is-open {
        display: flex;
      }
      .lead-modal {
        position: relative;
        width: 100%;
        max-width: 520px;
        max-height: 90vh;
        overflow: auto;
        background: #fff;
        border-radius: 20px;
        box-shadow: var(--shadow-xl);
        padding: 40px 36px 36px;
      }
      .lead-modal__close {
        position: absolute;
        top: 18px;
        right: 20px;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 50%;
        background: var(--neutral-50);
        color: var(--text-tertiary);
        font-size: 20px;
        line-height: 1;
        cursor: pointer;
        transition: color var(--transition-fast), background var(--transition-fast);
      }
      .lead-modal__close:hover {
        background: var(--neutral-100);
        color: var(--text-primary);
      }
      .lead-modal h2 {
        margin: 0 0 10px;
        font-size: 26px;
        font-weight: 800;
        color: var(--text-primary);
      }
      .lead-modal__desc {
        margin: 0 0 26px;
        font-size: 14px;
        line-height: 1.7;
        color: var(--text-secondary);
      }
      .lead-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .field label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary);
      }
      .field input,
      .field textarea {
        font: inherit;
        padding: 11px 14px;
        border: 1px solid var(--neutral-300);
        border-radius: var(--radius-md);
        background: #fff;
        color: var(--text-primary);
        transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
        resize: vertical;
      }
      .field input:focus,
      .field textarea:focus {
        outline: none;
        border-color: var(--brand-color);
        box-shadow: 0 0 0 3px var(--brand-color-bg);
      }
      .field input[aria-invalid='true'],
      .field textarea[aria-invalid='true'] {
        border-color: #c26d4b;
      }
      .field__hint {
        margin: -6px 0 0;
        font-size: 13px;
        color: var(--text-tertiary);
      }
      .lead-form__submit {
        margin-top: 4px;
      }
      .form-status {
        margin: 0;
        font-size: 14px;
      }
      .form-status[data-state='success'] {
        color: var(--brand-color-active);
      }
      .form-status[data-state='error'] {
        color: #c26d4b;
      }

      @media (max-width: 900px) {
        .site-nav {
          gap: 0;
        }
        .site-nav a {
          padding: 8px 10px;
        }
      }
      @media (max-width: 768px) {
        .site-nav,
        .hdr-login,
        .hdr-trial {
          display: none;
        }
        .hdr-burger {
          display: inline-flex;
        }
        .brand-subtitle {
          display: none;
        }
        .footer-top {
          flex-direction: column;
          gap: 30px;
        }
        .footer-bottom {
          flex-direction: column;
          text-align: center;
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-container site-header__inner">
        <a class="brand" href="/">
          <svg width="34" height="34" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="url(#brand-grad)" />
            <path d="M10 22V12L16 8L22 12V22L16 26L10 22Z" stroke="white" stroke-width="1.8" fill="none" />
            <circle cx="16" cy="17" r="3" fill="white" opacity="0.85" />
            <defs>
              <linearGradient id="brand-grad" x1="0" y1="0" x2="32" y2="32">
                <stop offset="0%" stop-color="#2f8f96" />
                <stop offset="100%" stop-color="#1b5f65" />
              </linearGradient>
            </defs>
          </svg>
          <span class="brand-text">
            <span class="brand-title">觉策科技</span>
            <span class="brand-subtitle">让经营与智能协同进化</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="主导航">
          <a href="/" aria-current={current('/')}>首页</a>
          <a href="/solutions/" aria-current={current('/solutions')}>行业方案</a>
          <a href="/features/" aria-current={current('/features')}>功能全景</a>
          <a href="/pricing/" aria-current={current('/pricing')}>价格方案</a>
          <a href="/#articles" aria-current={path.startsWith('/articles') ? 'page' : undefined}>文章</a>
        </nav>

        <div class="header-actions">
          <a class="hdr-login" href="//admin.juece.cloud/" target="_blank" rel="noopener">登录</a>
          <button class="btn btn--primary hdr-trial" type="button" data-open-lead>免费试用</button>
          <button class="hdr-burger" type="button" data-toggle-menu aria-label="打开菜单" aria-expanded="false">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <nav class="mobile-menu" id="mobile-menu" aria-label="移动端菜单">
      <a href="/">首页</a>
      <a href="/solutions/">行业方案</a>
      <a href="/features/">功能全景</a>
      <a href="/pricing/">价格方案</a>
      <a href="/#articles">文章</a>
      <div class="mobile-menu__actions">
        <button class="btn btn--outline" type="button" data-open-lead>免费试用</button>
        <a class="btn btn--outline" href="//admin.juece.cloud/" target="_blank" rel="noopener">登录</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-container">
        <div class="footer-top">
          <div class="footer-col brand-col">
            <div class="footer-logo">
              <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <rect width="32" height="32" rx="8" fill="#2f8f96" />
