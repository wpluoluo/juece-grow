# Payload CMS 源地址（单一事实来源）。复制为 apps/astro/.env 并按需修改。
PUBLIC_CMS_ORIGIN=http://127.0.0.1:3000
# 公开站绝对地址，用于 sitemap/robots/canonical。留空则构建时默认 localhost。
PUBLIC_SITE_ORIGIN=http://localhost:4321
# Chatwoot 在线客服：基础地址 + 网页渠道 token。两者都配置才会在站上注入客服控件。
PUBLIC_CHATWOOT_URL=http://localhost:3300
PUBLIC_CHATWOOT_WEBSITE_TOKEN=