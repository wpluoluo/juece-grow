# 本地开发连接（容器 Postgres，暴露 5434）。生产改为指向服务器原生 Postgres：
# DATABASE_URI=postgres://juece:<强密码>@127.0.0.1:5432/juece_grow
DATABASE_URI=postgres://juece:juece@127.0.0.1:5434/juece_grow
PAYLOAD_SECRET=replace-with-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3000

# 公开 API (v2) CORS 白名单：逗号分隔的 origin 列表，无内置默认。缺失/为空时首个 /api/v2/* 请求即 500
# （错误文本点名本变量，客户端只见空 500 不带堆栈）；部署期由 scripts/cms-run.sh 的 ${:?} 先行挡住。
PUBLIC_CORS_ORIGINS=https://juece.cloud,https://erp.juece.cloud,https://yunque.juece.cloud,http://localhost:4321,http://127.0.0.1:4321