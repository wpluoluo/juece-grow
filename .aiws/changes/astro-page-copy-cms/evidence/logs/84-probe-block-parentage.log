  page_home_texts: id, order, parent_id, path, text
  page_features_texts: id, order, parent_id, path, text
  page_features_numbers: id, number, order, parent_id, path
  page_solutions_texts: id, order, parent_id, path, text
  page_pricing_texts: id, order, parent_id, path, text
