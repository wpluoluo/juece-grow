# AIWS_MANAGED_BEGIN:gitignore
.aiws/tmp/
.aiws/backups/
.aiws/secrets/
secrets/test-accounts.json
.env
.env.*
!.env.example
!.env.*.example
# AIWS_MANAGED_END:gitignore

# node / build
node_modules/
dist/
dist-*/
.next/
.astro/
*.log
# 例外：change 证据台账（verification.jsonl）逐条引用的判定日志必须入库，否则换 clone 后指针全断链
!/.aiws/changes/**/evidence/logs/*.log
.DS_Store

# database backups (dated SQL dumps)
backups/

# generated / test artifacts
__pycache__/
*.pyc
test-results/
playwright-report/
next-env.d.ts
*.tsbuildinfo

# env
!.env.example

# 运行时资产 / 中间产物（不入库）
apps/cms/media/
apps/cms/public/
content-drafts/
cms-cookies.txt

# 构建产物（本地 docker 打包，不入库）
juece-grow-cms.tar
